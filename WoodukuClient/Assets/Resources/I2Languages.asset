      - "\u56E0\u7279\u62C9\u80AF\u5730\u5340\uFF0C\u4F2F\u6069\u9AD8\u5730"
      - Interlaken, Oberland Bernese
      - "\u30A4\u30F3\u30BF\u30FC\u30E9\u30FC\u30B1\u30F3\u5730\u533A\u3001\u30D9\u30EB\u30CA\u30FC\u30AA\u30FC\u30D0\u30FC\u30E9\u30F3\u30C8"
      - "\uC778\uD130\uB77C\uCF04 \uC9C0\uC5ED, \uBCA0\uB974\uB108 \uC624\uBC84\uB780\uD2B8"
      - "\u0406\u043D\u0442\u0435\u0440\u043B\u0430\u043A\u0435\u043D, \u0411\u0435\u0440\u043D\u0441\u044C\u043A\u0435
