      - Argentina, Buenos Aires
      - Argentina, Buenos Aires
      - "\u0411\u0443\u044D\u043D\u043E\u0441-\u0410\u0439\u0440\u0435\u0441, \u0410\u0440\u0433\u0435\u043D\u0442\u0438\u043D\u0430"
      - Buenos Aires, Argentinien
      - Buenos Aires, Argentine
      - Buenos Aires, Arjantin
      - "\u963F\u6839\u5EF7\uFF0C\u5E03\u5B9C\u8BFA\u65AF\u827E\u5229\u65AF"
      - Buenos Aires, Argentina
      - "\u963F\u6839\u5EF7\uFF0C\u5E03\u5B9C\u8AFE\u65AF\u827E\u5229\u65AF"
      - Buenos Aires, Argentina
      - "\u30A2\u30EB\u30BC\u30F3\u30C1\u30F3\u3001\u30D6\u30A8\u30CE\u30B9\u30A2\u30A4\u30EC\u30B9"
      - "\uC544\uB974\uD5E8\uD2F0\uB098, \uBD80\uC5D0\uB178\uC2A4\uC544\uC774\uB808\uC2A4"
      - "\u0411\u0443\u0435\u043D\u043E\u0441-\u0410\u0439\u0440\u0435\u0441, \u0410\u0440\u0433\u0435\u043D\u0442\u0438\u043D\u0430"
      - "\r"
