      - "Su\xE9cia, Prov\xEDncia de V\xE4stra G\xF6taland"
      - "\u0428\u0432\u0435\u0446\u0438\u044F, \u0417\u0430\u043F\u0430\u0434\u043D\u0430\u044F
        \u0413\u0451\u0442\u0430\u043B\u0430\u043D\u0434\u0441\u043A\u0430\u044F
        \u043E\u0431\u043B\u0430\u0441\u0442\u044C"
