      - "\u30B9\u30A6\u30A7\u30FC\u30C7\u30F3\u3001\u30F4\u30A7\u30B9\u30C8\u30E9\u30FB\u30A4\u30A7\u30FC\u30BF\u30E9\u30F3\u30C9\u770C"
      - "\uC2A4\uC6E8\uB374, \uBCA0\uC2A4\uD2B8\uB77C\uC608\uD0C8\uB780\uB4DC\uC8FC"
      - "\u0428\u0432\u0435\u0446\u0456\u044F, \u043B\u0435\u043D \u0412\u0435\u0441\u0442\u0440\u0430-\u0413\u0435\u0442\u0430\u043B\u0430\u043D\u0434"
