      - "\u30B6\u30AF\u30BB\u30F3\u30FB\u30B9\u30A4\u30B9\u56FD\u7ACB\u516C\u5712"
      - "\uC791\uC13C \uC288\uBC14\uC774\uCE20 \uAD6D\uB9BD\uACF5\uC6D0"
      - "\u041D\u0430\u0446\u0456\u043E\u043D\u0430\u043B\u044C\u043D\u0438\u0439
        \u043F\u0430\u0440\u043A \u0421\u0430\u043A\u0441\u043E\u043D\u0441\u044C\u043A\u0430
