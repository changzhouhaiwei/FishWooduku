      - "\u7121\u9650\u30EC\u30D9\u30EB\u30E2\u30FC\u30C9\u3067"
      - "\uBB34\uD55C \uB808\uBCA8 \uBAA8\uB4DC\uC5D0\uC11C"
      - "\u0423 \u0440\u0435\u0436\u0438\u043C\u0456 \u043D\u0435\u0441\u043A\u0456\u043D\u0447\u0435\u043D\u043D\u0438\u0445
        \u0440\u0456\u0432\u043D\u0456\u0432"
