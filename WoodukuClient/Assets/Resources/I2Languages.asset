      - "\u30B9\u30A6\u30A7\u30FC\u30C7\u30F3\u3001\u30B9\u30C8\u30C3\u30AF\u30DB\u30EB\u30E0\u770C"
      - "\uC2A4\uC6E8\uB374, \uC2A4\uD1A1\uD640\uB984\uC8FC"
      - "\u041B\u0435\u043D \u0421\u0442\u043E\u043A\u0433\u043E\u043B\u044C\u043C,
        \u0428\u0432\u0435\u0446\u0456\u044F"
