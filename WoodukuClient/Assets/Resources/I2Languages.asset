      - "\u745E\u5178\uFF0C\u8036\u592B\u52D2\u5821\u7E23"
      - "Contea di G\xE4vleborg, Svezia"
      - "\u30B9\u30A6\u30A7\u30FC\u30C7\u30F3\u3001\u30A4\u30A7\u30FC\u30D6\u30EC\u30DC\u30EA\u770C"
      - "\uC2A4\uC6E8\uB374, \uC608\uBE14\uB808\uBCF4\uB9AC\uC8FC"
      - "\u041B\u0435\u043D \u0413\u0435\u0432\u043B\u0435\u0431\u043E\u0440\u0433,
