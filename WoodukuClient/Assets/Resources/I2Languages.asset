      - Suecia, Provincia de Estocolmo
      - "Su\xE9cia, Prov\xEDncia de Estocolmo"
      - "\u0421\u0442\u043E\u043A\u0433\u043E\u043B\u044C\u043C\u0441\u043A\u0430\u044F
        \u043E\u0431\u043B\u0430\u0441\u0442\u044C, \u0428\u0432\u0435\u0446\u0438\u044F"
      - "Stockholms l\xE4n, Schweden"
      - "Comt\xE9 de Stockholm, Su\xE8de"
      - "\u0130sve\xE7, Stockholm County"
      - "\u745E\u5178\uFF0C\u65AF\u5FB7\u54E5\u5C14\u6469\u53BF"
