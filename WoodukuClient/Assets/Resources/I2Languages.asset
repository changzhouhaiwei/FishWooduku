      - "\u30D0\u30EB\u30BB\u30ED\u30CA\u5DDE\u3001\u30AB\u30BF\u30EB\u30FC\u30CB\u30E3"
      - "\uBC14\uB974\uC140\uB85C\uB098 \uC8FC, \uCE74\uD0C8\uB85C\uB2C8\uC544"
      - "\u043F\u0440\u043E\u0432\u0456\u043D\u0446\u0456\u044F \u0411\u0430\u0440\u0441\u0435\u043B\u043E\u043D\u0430,
