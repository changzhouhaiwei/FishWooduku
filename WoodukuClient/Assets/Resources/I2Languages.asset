      - "R\xFCgen, Mecklemburgo-Pomer\xE2nia Ocidental"
      - "\u0420\u044E\u0433\u0435\u043D, \u041C\u0435\u043A\u043B\u0435\u043D\u0431\u0443\u0440\u0433-\u041F\u0435\u0440\u0435\u0434\u043D\u044F\u044F
        \u041F\u043E\u043C\u0435\u0440\u0430\u043D\u0438\u044F"
      - "R\xFCgen, Mecklenburg-Vorpommern"
      - "R\xFCgen, Mecklembourg-Pom\xE9ranie-Occidentale"
      - "R\xFCgen, Mecklenburg-Vorpommern"
      - "\u5415\u6839\u5C9B\uFF0C\u6885\u514B\u4F26\u5821-\u524D\u6CE2\u7F8E\u62C9\u5C3C\u4E9A\u5DDE"
      - "R\xFCgen, Mecklenburg-Vorpommern"
      - "\u5442\u6839\u5CF6\uFF0C\u6885\u514B\u502B\u5821-\u524D\u6CE2\u7F8E\u62C9\u5C3C\u4E9E\u5DDE"
      - "R\xFCgen, Meclemburgo-Pomerania Anteriore"
      - "\u30EA\u30E5\u30FC\u30B2\u30F3\u5CF6\u3001\u30E1\u30AF\u30EC\u30F3\u30D6\u30EB\u30AF\uFF1D\u30D5\u30A9\u30A2\u30DD\u30F3\u30E1\u30EB\u30F3\u5DDE"
      - "\uB93C\uAC90\uC12C, \uBA54\uD074\uB80C\uBD80\uB974\uD06C\uD3EC\uC5B4\uD3EC\uBA54\uB978\uC8FC"
      - "\u0420\u044E\u0433\u0435\u043D, \u041C\u0435\u043A\u043B\u0435\u043D\u0431\u0443\u0440\u0433-\u041F\u0435\u0440\u0435\u0434\u043D\u044F
        \u041F\u043E\u043C\u0435\u0440\u0430\u043D\u0456\u044F"
