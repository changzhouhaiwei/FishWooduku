      - "Su\xE9cia, Prov\xEDncia de G\xE4vleborg"
      - "\u0413\u0440\u0430\u0444\u0441\u0442\u0432\u043E \u0413\u0435\u0432\u043B\u0435\u0431\u043E\u0440\u0433,
        \u0428\u0432\u0435\u0446\u0438\u044F"
      - "G\xE4vleborgs l\xE4n, Schweden"
      - "Comt\xE9 de G\xE4vleborg, Su\xE8de"
      - "G\xE4vleborg \u0130li, \u0130sve\xE7"
      - "\u745E\u5178\uFF0C\u8036\u592B\u52D2\u5821\u53BF"
