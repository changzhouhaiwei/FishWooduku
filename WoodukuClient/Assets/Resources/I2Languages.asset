      - "\u30D1\u30BA\u30EB\u306E\u6642\u9593\uFF01"
      - "\uD37C\uC990 \uD0C0\uC784!"
      - "\u0427\u0430\u0441 \u0434\u043B\u044F \u043F\u0430\u0437\u043B\u0443!"
