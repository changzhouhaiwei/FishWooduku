      - "\u30A2\u30E1\u30EA\u30AB\u3001\u30DA\u30F3\u30B7\u30EB\u30D9\u30CB\u30A2\u5DDE"
      - "\uBBF8\uAD6D \uD39C\uC2E4\uBCA0\uC774\uB2C8\uC544\uC8FC"
